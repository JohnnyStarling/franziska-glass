            <intent-filter><action android:name="com.google.android.glass.action.VOICE_TRIGGER" /></intent-filter>
            <meta-data android:name="com.google.android.glass.VoiceTrigger" android:resource="@xml/gallery_voice_trigger" />
        </activity>
        <service android:name=".GalleryShareService" android:exported="false" />
        <service android:name=".PhotoSyncService" android:exported="false" />
        <receiver android:name=".PhotoSyncBootReceiver" android:exported="false">
