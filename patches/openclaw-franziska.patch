index 0000000000000000000000000000000000000000..d59cccbdecb4f719af99cdd78966082606ef77da
--- /dev/null
+++ b/src/gateway/talk/relay/agent-control.ts
@@ -0,0 +1,36 @@
+import { formatErrorMessage as formatError } from "../../../infra/errors.js";
+import { REALTIME_VOICE_AGENT_CONTROL_FAILURE_MESSAGE } from "../../../talk/agent-run-control-shared.js";
+import type { createTalkRealtimeRunControlOwner } from "../realtime-run-control.js";
+import { submitTalkRealtimeRelayToolResult } from "./operations.js";
+import type { RelaySession } from "./state.js";
+
+/** Route native controls to the server owner, never the occupied companion dispatcher. */
+export function enqueueTalkRealtimeRelayAgentControl(params: {
+  session: RelaySession;
+  runControl: Pick<ReturnType<typeof createTalkRealtimeRunControlOwner>, "enqueue">;
+  callId: string;
+  args: unknown;
+}): void | Promise<void> {
+  const { session, runControl, callId } = params;
+  if (!session.toolCalls.tryQueueAgentControl(callId)) {
+    return;
+  }
+  const submitControl = (result: unknown) =>
+    submitTalkRealtimeRelayToolResult({
+      relaySessionId: session.id,
+      connId: session.connId,
+      callId,
+      result,
+    });
+  if (
+    !runControl.enqueue(params.args, {
+      onResult: submitControl,
+      onError: (error) => {
+        session.context.logGateway.warn(`realtime Talk control failed: ${formatError(error)}`);
+        return submitControl({ error: REALTIME_VOICE_AGENT_CONTROL_FAILURE_MESSAGE });
+      },
+    })
+  ) {
+    return submitControl({ error: "Realtime Talk control queue is full" });
+  }
+}
