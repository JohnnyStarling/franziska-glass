index 693c8cd03e34276e4d801abca7837e95301dfa15..01c492b243adf30167f6efe71b9c808bba64e467 100644
--- a/docs/gateway/protocol/rpc-talk-config-and-agents.md
+++ b/docs/gateway/protocol/rpc-talk-config-and-agents.md
@@ -17,6 +17,7 @@ RPC method families for Talk and TTS, secrets, config, update, and wizard flows,
 - `talk.config` returns the effective Talk config payload from the Gateway's applied runtime and matching source snapshot; pending or rejected file edits appear only after a successful config reload. `includeSecrets` requires `operator.talk.secrets` (or `operator.admin`).
 - `talk.session.create` (`operator.talk`) creates a gateway-owned Talk session for `realtime/gateway-relay`, `transcription/gateway-relay`, or `stt-tts/managed-room`. For `stt-tts/managed-room`, non-admin callers that pass `sessionKey` must also pass `spawnedBy` for scoped session-key visibility; unscoped `sessionKey` creation and `brain: "direct-tools"` require `operator.admin`.
 - `talk.session.appendAudio` appends base64 PCM input audio to gateway-owned realtime relay and transcription sessions.
+- `talk.session.sendText` (`operator.talk`) sends `{ sessionId, text }` through the existing realtime relay’s provider connection. Text is trimmed, must contain a non-whitespace character, and is limited to 8,192 characters, including any client-provided speech instruction. Only the owning Gateway connection can send; the backing session’s write permissions still apply. Unknown, closed, unready, disconnected, or text-incapable relays return `UNAVAILABLE`; invalid parameters and non-realtime sessions return `INVALID_REQUEST`. Success is `{ ok: true }`, confirming submission, not completed speech. This never creates a session, reconnects, synthesizes TTS, or submits a tool result.
 - `talk.session.cancelOutput` stops assistant audio output, primarily for VAD-gated barge-in in gateway relay sessions. Send the `turnId` from the current audio event's `talkEvent`; the result is `applied`, `stale`, or `idle`.
 - `talk.session.submitToolResult` completes a provider tool call emitted by a gateway-owned realtime relay session. The request waits for any asynchronous completion signal exposed by the provider bridge; failed submissions keep the linked run active and do not emit a successful tool-result event. Pass `options: { willContinue: true }` for interim tool output or `options: { suppressResponse: true }` when the provider bridge advertises suppression support and the result should not start another response.
 - `talk.session.steer` sends active-run voice control into a gateway-owned agent-backed Talk session: `{ sessionId, text, mode? }`, where `mode` is `status`, `steer`, `cancel`, or `followup`; omitted mode is classified from the spoken text. It selects only work bound to that logical voice call, not another call sharing the connection and agent session.
diff --git a/extensions/google/realtime-voice-consult-serialization.test.ts b/extensions/google/realtime-voice-consult-serialization.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c4ac0c2d5dccc79675049233dcc6f3c0471eeb9c
--- /dev/null
+++ b/extensions/google/realtime-voice-consult-serialization.test.ts
@@ -0,0 +1,441 @@
+import type { LiveConnectConfig, LiveServerMessage } from "@google/genai";
+import type { RealtimeVoiceBridge, RealtimeVoiceTool } from "openclaw/plugin-sdk/realtime-voice";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { buildGoogleRealtimeVoiceProvider } from "./realtime-voice-provider.js";
+
+const CONSULT = "openclaw_agent_consult";
+const CONTROL = "openclaw_agent_control";
+const REGULAR = "gemini-3.8-live";
+const LEGACY = "gemini-2.5-flash-native-audio-preview-12-2025";
+const EXTENDED = "gemini-3.8-live-extended-thinking";
+const SEQUENTIAL = "gemini-3.1-flash-live-preview";
+
+type ConnectParams = {
+  model: string;
+  config: LiveConnectConfig;
+  callbacks: {
+    onopen: () => void;
+    onmessage: (message: LiveServerMessage) => void;
+    onclose: (event?: { code?: number; reason?: string; wasClean?: boolean }) => void;
+  };
+};
+const { connectMock, createGoogleGenAIMock, createTokenMock, session } = vi.hoisted(() => {
+  const liveSession = {
+    close: vi.fn(),
+    sendClientContent: vi.fn(),
+    sendRealtimeInput: vi.fn(),
+    sendToolResponse: vi.fn(),
+  };
+  const connect = vi.fn(async (_params: ConnectParams) => liveSession);
+  const createToken = vi.fn(async (_params: unknown) => ({ name: "auth_tokens/synthetic" }));
+  return {
+    session: liveSession,
+    connectMock: connect,
+    createTokenMock: createToken,
+    createGoogleGenAIMock: vi.fn(() => ({
+      authTokens: { create: createToken },
+      live: { connect },
+    })),
+  };
+});
+vi.mock("./google-genai-runtime.js", () => ({ createGoogleGenAI: createGoogleGenAIMock }));
+
+const consultTool: RealtimeVoiceTool = {
+  type: "function",
+  name: CONSULT,
+  description: "Consult the main agent for one synthetic answer",
+  parameters: { type: "object", properties: { prompt: { type: "string" } } },
+};
+const controlTool: RealtimeVoiceTool = { ...consultTool, name: CONTROL };
+const opened: RealtimeVoiceBridge[] = [];
+
+function connection(): ConnectParams {
+  const params = connectMock.mock.calls.at(-1)?.[0];
+  if (!params) {
+    throw new Error("expected Live transport connect");
+  }
+  return params;
+}
+
+function receive(message: LiveServerMessage) {
+  connection().callbacks.onmessage(message);
+}
+
+function call(id: string, prompt = "Synthetic request") {
+  receive({ toolCall: { functionCalls: [{ id, name: CONSULT, args: { prompt } }] } });
+}
+
+function control(id: string, mode = "cancel") {
+  receive({ toolCall: { functionCalls: [{ id, name: CONTROL, args: { mode } }] } });
+}
+
+async function open(model = REGULAR, tools: RealtimeVoiceTool[] = [consultTool]) {
+  const onToolCall = vi.fn();
+  const onAudio = vi.fn();
+  const onError = vi.fn();
+  const onEvent = vi.fn();
+  const bridge = buildGoogleRealtimeVoiceProvider().createBridge({
+    providerConfig: { apiKey: "synthetic-key", model, voice: "Aoede" },
+    tools,
+    onAudio,
+    onClearAudio: vi.fn(),
+    onToolCall,
+    onError,
+    onEvent,
+  });
+  opened.push(bridge);
+  await bridge.connect();
+  connection().callbacks.onopen();
+  receive({ setupComplete: {} });
+  return { bridge, onToolCall, onAudio, onError, onEvent };
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+});
+afterEach(async () => {
+  for (const bridge of opened.splice(0)) {
+    await bridge.close();
+  }
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+describe("Google Live consult serialization", () => {
+  it.each([REGULAR, `models/${REGULAR}`])(
+    "batches %s cancellation terminals into one native response without awaiting CONTROL",
+    async (model) => {
+      const { bridge } = await open(model, [consultTool, controlTool]);
+      call("cancelled-consult");
+      control("cancel-control");
+      // The relay awaits this acceptance before it can produce the CONTROL result.
+      await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+      await bridge.submitToolResult("cancelled-consult", {
+        text: "late answer must not replace it",
+      });
+      expect(session.sendToolResponse).not.toHaveBeenCalled();
+      await bridge.submitToolResult("cancel-control", { mode: "cancel", status: "cancelled" });
+      expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+        functionResponses: [
+          { id: "cancelled-consult", name: CONSULT, response: { status: "cancelled" } },
+          {
+            id: "cancel-control",
+            name: CONTROL,
+            response: { mode: "cancel", status: "cancelled" },
+          },
+        ],
+      });
+      await bridge.submitToolResult("cancelled-consult", { text: "late answer" });
+      await bridge.submitToolResult("cancel-control", { mode: "cancel" });
+      expect(session.sendToolResponse).toHaveBeenCalledOnce();
+    },
+  );
+
+  it("does not hold status, unrelated tools, or the batch behind unrelated pending calls", async () => {
+    const { bridge } = await open(REGULAR, [consultTool, controlTool]);
+    call("long-consult");
+    control("status-control", "status");
+    await bridge.submitToolResult("status-control", { mode: "status", active: true });
+    expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+      functionResponses: [
+        { id: "status-control", name: CONTROL, response: { mode: "status", active: true } },
+      ],
+    });
+    control("first-cancel");
+    control("second-cancel");
+    control("later-status", "status");
+    call("unrelated-consult");
+    receive({ toolCall: { functionCalls: [{ id: "photo", name: "photo", args: {} }] } });
+    await bridge.submitToolResult("long-consult", { status: "cancelled" });
+    await bridge.submitToolResult("later-status", { mode: "status", active: true });
+    expect(session.sendToolResponse).toHaveBeenLastCalledWith({
+      functionResponses: [
+        { id: "later-status", name: CONTROL, response: { mode: "status", active: true } },
+      ],
+    });
+    await bridge.submitToolResult("first-cancel", { mode: "cancel", ok: true });
+    expect(session.sendToolResponse).toHaveBeenCalledTimes(2);
+    await bridge.submitToolResult("photo", { image: "synthetic" });
+    expect(session.sendToolResponse).toHaveBeenLastCalledWith({
+      functionResponses: [{ id: "photo", name: "photo", response: { image: "synthetic" } }],
+    });
+    await bridge.submitToolResult("second-cancel", { mode: "cancel", ok: true });
+    expect(session.sendToolResponse).toHaveBeenCalledTimes(4);
+    expect(session.sendToolResponse).toHaveBeenLastCalledWith({
+      functionResponses: [
+        { id: "long-consult", name: CONSULT, response: { status: "cancelled" } },
+        { id: "first-cancel", name: CONTROL, response: { mode: "cancel", ok: true } },
+        { id: "second-cancel", name: CONTROL, response: { mode: "cancel", ok: true } },
+      ],
+    });
+  });
+
+  it("does not wait on a pending status control for an unrelated consult cancellation", async () => {
+    const { bridge } = await open(REGULAR, [consultTool, controlTool]);
+    call("cancelled-consult");
+    control("status-control", "status");
+    await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+    expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+      functionResponses: [
+        { id: "cancelled-consult", name: CONSULT, response: { status: "cancelled" } },
+      ],
+    });
+    await bridge.submitToolResult("status-control", { mode: "status", active: true });
+    expect(session.sendToolResponse).toHaveBeenCalledTimes(2);
+    expect(session.sendToolResponse).toHaveBeenLastCalledWith({
+      functionResponses: [
+        { id: "status-control", name: CONTROL, response: { mode: "status", active: true } },
+      ],
+    });
+  });
+
+  it("preserves the accepted cancellation prefix across serialization and SDK send failures", async () => {
+    const { bridge, onError } = await open(REGULAR, [consultTool, controlTool]);
+    call("cancelled-consult");
+    control("cancel-control");
+    await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+    expect(() => bridge.submitToolResult("cancel-control", undefined)).toThrow(/serializ/i);
+    expect(session.sendToolResponse).not.toHaveBeenCalled();
+    const failure = new Error("synthetic SDK send failure");
+    session.sendToolResponse.mockImplementationOnce(() => {
+      throw failure;
+    });
+    expect(() => bridge.submitToolResult("cancel-control", { mode: "cancel" })).toThrow(failure);
+    expect(onError).toHaveBeenCalledTimes(2);
+    await bridge.submitToolResult("cancel-control", { mode: "cancel" });
+    const batch = {
+      functionResponses: [
+        { id: "cancelled-consult", name: CONSULT, response: { status: "cancelled" } },
+        { id: "cancel-control", name: CONTROL, response: { mode: "cancel" } },
+      ],
+    };
+    expect(session.sendToolResponse.mock.calls).toEqual([[batch], [batch]]);
+    await bridge.submitToolResult("cancelled-consult", { text: "must stay cancelled" });
+    expect(session.sendToolResponse).toHaveBeenCalledTimes(2);
+  });
+
+  it("keeps the existing byte limit and a rejected buffered result retryable", async () => {
+    const { bridge, onError } = await open(REGULAR, [consultTool, controlTool]);
+    call("cancelled-consult");
+    control("cancel-control");
+    expect(() =>
+      bridge.submitToolResult("cancelled-consult", {
+        status: "cancelled",
+        text: "x".repeat(1024 * 1024),
+      }),
+    ).toThrow("tool-response buffer limit exceeded");
+    expect(onError).toHaveBeenCalledOnce();
+    expect(session.sendToolResponse).not.toHaveBeenCalled();
+    await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+    await bridge.submitToolResult("cancel-control", { mode: "cancel" });
+    expect(session.sendToolResponse).toHaveBeenCalledOnce();
+    expect(session.sendToolResponse.mock.calls[0]?.[0].functionResponses).toHaveLength(2);
+  });
+
+  it("removes native-cancelled members and releases a remaining required terminal", async () => {
+    const { bridge } = await open(REGULAR, [consultTool, controlTool]);
+    call("cancelled-consult");
+    control("cancel-control");
+    await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+    receive({ toolCallCancellation: { ids: ["cancelled-consult"] } });
+    await bridge.submitToolResult("cancel-control", { mode: "cancel" });
+    expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+      functionResponses: [{ id: "cancel-control", name: CONTROL, response: { mode: "cancel" } }],
+    });
+    session.sendToolResponse.mockClear();
+    call("second-consult");
+    control("second-control");
+    await bridge.submitToolResult("second-consult", { status: "cancelled" });
+    receive({ toolCallCancellation: { ids: ["second-control"] } });
+    expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+      functionResponses: [
+        { id: "second-consult", name: CONSULT, response: { status: "cancelled" } },
+      ],
+    });
+  });
+
+  it("batches accepted terminals across resumable reconnect and drops them on close", async () => {
+    vi.useFakeTimers();
+    const { bridge } = await open(REGULAR, [consultTool, controlTool]);
+    receive({ sessionResumptionUpdate: { resumable: true, newHandle: "synthetic-handle" } });
+    call("cancelled-consult");
+    control("cancel-control");
+    await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+    connection().callbacks.onclose({ code: 1012, reason: "synthetic restart" });
+    await bridge.submitToolResult("cancel-control", { mode: "cancel" });
+    expect(session.sendToolResponse).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(250);
+    connection().callbacks.onopen();
+    receive({ setupComplete: {} });
+    expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+      functionResponses: [
+        { id: "cancelled-consult", name: CONSULT, response: { status: "cancelled" } },
+        { id: "cancel-control", name: CONTROL, response: { mode: "cancel" } },
+      ],
+    });
+    session.sendToolResponse.mockClear();
+    call("close-consult");
+    control("close-control");
+    await bridge.submitToolResult("close-consult", { status: "cancelled" });
+    await bridge.close();
+    await bridge.connect();
+    connection().callbacks.onopen();
+    receive({ setupComplete: {} });
+    expect(session.sendToolResponse).not.toHaveBeenCalled();
+  });
+
+  it.each([LEGACY, EXTENDED, SEQUENTIAL])(
+    "does not batch cancellation terminals for %s",
+    async (model) => {
+      const { bridge } = await open(model, [consultTool, controlTool]);
+      call("cancelled-consult");
+      control("cancel-control");
+      await bridge.submitToolResult("cancelled-consult", { status: "cancelled" });
+      expect(session.sendToolResponse).toHaveBeenCalledOnce();
+      await bridge.submitToolResult("cancel-control", { mode: "cancel" });
+      expect(session.sendToolResponse).toHaveBeenCalledTimes(2);
+      expect(
+        session.sendToolResponse.mock.calls.map(([payload]) => payload.functionResponses.length),
+      ).toEqual([1, 1]);
+      expect(session.sendToolResponse.mock.calls[0]?.[0].functionResponses[0]).toEqual({
+        id: "cancelled-consult",
+        name: CONSULT,
+        response: { status: "cancelled" },
+        ...(model === LEGACY ? { scheduling: "WHEN_IDLE" } : {}),
+      });
+    },
+  );
+
+  it.each([REGULAR, `models/${REGULAR}`])(
+    "serializes %s consult as blocking with one final result and no interim scheduling",
+    async (model) => {
+      const { bridge, onToolCall } = await open(model);
+      // Capture the actual request assembled by the provider, not just its capability helper.
+      const setup = structuredClone(connection().config);
+      expect(setup.tools).toEqual([
+        {
+          functionDeclarations: [
+            {
+              name: CONSULT,
+              description: consultTool.description,
+              parameters: consultTool.parameters,
+            },
+          ],
+        },
+      ]);
+      expect(bridge.supportsToolResultContinuation).toBe(false);
+      call("ordinary-consult");
+      call("ordinary-consult");
+      expect(onToolCall).toHaveBeenCalledExactlyOnceWith({
+        itemId: "ordinary-consult",
+        callId: "ordinary-consult",
+        name: CONSULT,
+        args: { prompt: "Synthetic request" },
+      });
+      expect(session.sendToolResponse).not.toHaveBeenCalled();
+      expect(() =>
+        bridge.submitToolResult("ordinary-consult", { status: "working" }, { willContinue: true }),
+      ).toThrow("does not support continuing tool responses");
+      expect(session.sendToolResponse).not.toHaveBeenCalled();
+
+      await bridge.submitToolResult("ordinary-consult", { text: "One final synthetic answer." });
+      await bridge.submitToolResult("ordinary-consult", {
+        text: "Duplicate completion must not speak.",
+      });
+      expect(session.sendToolResponse).toHaveBeenCalledExactlyOnceWith({
+        functionResponses: [
+          {
+            id: "ordinary-consult",
+            name: CONSULT,
+            response: { text: "One final synthetic answer." },
+          },
+        ],
+      });
+      expect(JSON.stringify(session.sendToolResponse.mock.calls)).not.toContain("WHEN_IDLE");
+      expect(JSON.stringify(session.sendToolResponse.mock.calls)).not.toContain("willContinue");
+    },
+  );
+
+  it("uses the same blocking declaration in browser token constraints", async () => {
+    await buildGoogleRealtimeVoiceProvider().createBrowserSession?.({
+      providerConfig: { apiKey: "synthetic-key", model: REGULAR },
+      tools: [consultTool],
+    });
+    expect(createTokenMock).toHaveBeenCalledWith({
+      config: expect.objectContaining({
+        liveConnectConstraints: expect.objectContaining({
+          model: REGULAR,
+          config: expect.objectContaining({
+            tools: [
+              {
+                functionDeclarations: [
+                  {
+                    name: CONSULT,
+                    description: consultTool.description,
+                    parameters: consultTool.parameters,
+                  },
+                ],
+              },
+            ],
+          }),
+        }),
+      }),
+    });
+  });
+
+  it("preserves legacy async interim, Extended Thinking non-blocking and 3.1 sequential contracts", async () => {
+    for (const [model, behavior, continuation] of [
+      [LEGACY, "NON_BLOCKING", true],
+      [EXTENDED, "NON_BLOCKING", false],
+      [SEQUENTIAL, undefined, false],
+    ] as const) {
+      session.sendToolResponse.mockClear();
+      const { bridge } = await open(model);
+      expect(connection().config.tools).toEqual([
+        {
+          functionDeclarations: [
+            {
+              name: CONSULT,
+              description: consultTool.description,
+              parameters: consultTool.parameters,
+              ...(behavior ? { behavior } : {}),
+            },
+          ],
+        },
+      ]);
+      expect(bridge.supportsToolResultContinuation).toBe(continuation);
+      call("compatible-consult");
+      if (continuation) {
+        await bridge.submitToolResult(
+          "compatible-consult",
+          { status: "working" },
+          { willContinue: true },
+        );
+        expect(session.sendToolResponse).toHaveBeenCalledWith({
+          functionResponses: [
+            {
+              id: "compatible-consult",
+              name: CONSULT,
+              response: { status: "working" },
+              scheduling: "WHEN_IDLE",
+              willContinue: true,
+            },
+          ],
+        });
+      }
+      await bridge.submitToolResult("compatible-consult", { text: "Compatible final answer." });
+      expect(session.sendToolResponse).toHaveBeenLastCalledWith({
+        functionResponses: [
+          {
+            id: "compatible-consult",
+            name: CONSULT,
+            response: { text: "Compatible final answer." },
+            ...(continuation ? { scheduling: "WHEN_IDLE" } : {}),
+          },
+        ],
+      });
+      expect(session.sendToolResponse).toHaveBeenCalledTimes(continuation ? 2 : 1);
+      await bridge.close();
+    }
+  });
+});
diff --git a/extensions/google/realtime-voice-model-contract.ts b/extensions/google/realtime-voice-model-contract.ts
index 2e05c485b6319b2ea09d46b240025ba8801712fe..dbf11db9af0803a401373203b19e11ba46aa261e 100644
--- a/extensions/google/realtime-voice-model-contract.ts
+++ b/extensions/google/realtime-voice-model-contract.ts
@@ -60,11 +60,20 @@ export function supportsAsyncFunctionCalling(model: string): boolean {
   return !isGemini31LiveModel(model);
 }
 
-// Continuation means an interim `willContinue` response scheduled WHEN_IDLE before the
-// final result. Extended Thinking rejects the scheduling and abandons the call after the
-// interim, so it gets one final response per call like Gemini 3.1 Live.
+// Regular 3.8 consults wait for the agent's answer: asynchronous working results
+// elicited a second acknowledgement and speculative speech before the real result.
+// Extended Thinking requires non-blocking declarations; older models keep their contract.
+export function usesNonBlockingAgentConsult(model: string): boolean {
+  return (
+    supportsAsyncFunctionCalling(model) &&
+    (!isGemini38LiveModel(model) || isGemini38LiveExtendedThinkingModel(model))
+  );
+}
+
+// Only the enabled non-blocking contract can accept an interim WHEN_IDLE result.
+// Extended Thinking rejects that scheduling, so it still gets one final response.
 export function modelSupportsToolResultContinuation(model: string): boolean {
-  return supportsAsyncFunctionCalling(model) && !isGemini38LiveExtendedThinkingModel(model);
+  return usesNonBlockingAgentConsult(model) && !isGemini38LiveExtendedThinkingModel(model);
 }
 
 // Gemini Live has no response.cancel. Extended Thinking documents that a completed
