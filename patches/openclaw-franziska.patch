diff --git a/src/gateway/talk/relay/output-ownership.test.ts b/src/gateway/talk/relay/output-ownership.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d4d4ef49001c2c4b6729e20927d52cd986cc396
--- /dev/null
+++ b/src/gateway/talk/relay/output-ownership.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it, vi } from "vitest";
+import { TalkRealtimeRelayOutputOwnership } from "./state.js";
+import { MAX_RELAY_TOOL_CALL_IDENTITIES } from "./tool-call-ledger.js";
+
+function fixture() {
+  let active: string | undefined;
+  const fail = vi.fn();
+  const owner = new TalkRealtimeRelayOutputOwnership(
+    () => active,
+    () => (active ??= "successor"),
+    fail,
+    () => false,
+  );
+  return {
+    owner,
+    fail,
+    finish: () => {
+      active = undefined;
+      owner.finish(undefined);
+    },
+  };
+}
+
+describe("pending relay speech admission", () => {
+  it("keeps a current reference when an earlier result loses its authority", () => {
+    const { owner, fail, finish } = fixture();
+    let firstCurrent = true;
+    owner.expectSpeech(() => firstCurrent);
+    owner.expectSpeech(() => true);
+    firstCurrent = false;
+    expect(owner.resolve(true, "speech")).toBe("successor");
+    expect(fail).not.toHaveBeenCalled();
+    finish();
+    expect(owner.resolve(true, "speech")).toBeUndefined();
+    expect(fail).toHaveBeenCalledOnce();
+  });
+
+  it("does not let an old rejection revoke a new generation's expectation", () => {
+    const { owner, fail } = fixture();
+    const releaseOld = owner.expectSpeech(() => true);
+    owner.resetContinuity();
+    owner.expectSpeech(() => true);
+    releaseOld?.();
+    expect(owner.resolve(true, "speech")).toBe("successor");
+    expect(fail).not.toHaveBeenCalled();
+  });
+
+  it("keeps a current reference when an older authority check throws", () => {
+    const { owner, fail } = fixture();
+    let retired = false;
+    owner.expectSpeech(() => {
+      if (retired) {
+        throw new Error("retired source");
+      }
+      return true;
+    });
+    owner.expectSpeech(() => true);
+    retired = true;
+    expect(owner.resolve(true, "speech")).toBe("successor");
+    expect(fail).not.toHaveBeenCalled();
+  });
+
+  it("bounds references by the existing native identity limit", () => {
+    const { owner, fail } = fixture();
+    for (let i = 0; i < MAX_RELAY_TOOL_CALL_IDENTITIES; i += 1) {
+      expect(owner.expectSpeech(() => true)).toBeTypeOf("function");
+    }
+    expect(owner.expectSpeech(() => true)).toBeUndefined();
+    expect(fail).toHaveBeenCalledExactlyOnceWith(
+      "Realtime pending speech admission limit exceeded.",
+    );
+  });
+});
