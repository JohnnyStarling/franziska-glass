diff --git a/src/gateway/talk/handlers/session-send-text.test.ts b/src/gateway/talk/handlers/session-send-text.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..92556aa0272c0efc1c50f7eb2788f101e9b2546d
--- /dev/null
+++ b/src/gateway/talk/handlers/session-send-text.test.ts
@@ -0,0 +1,194 @@
+import { beforeEach, describe, expect, it, onTestFinished, vi, type Mock } from "vitest";
+import type {
+  RealtimeVoiceBridge,
+  RealtimeVoiceBridgeCreateRequest,
+} from "../../../talk/provider-types.js";
+import { useRelayFixtures } from "../relay/fixture.test-support.js";
+import { createIdleRelayProvider, makeRelayTransport } from "../relay/index.test-support.js";
+import { forgetUnifiedTalkSession, rememberUnifiedTalkSession } from "../session-registry.js";
+import { createTalkHandlerCaller } from "./handler-invocation.test-support.js";
+import { talkSessionHandlers } from "./session.js";
+
+describe("talk.session.sendText", () => {
+  const createRelay = useRelayFixtures();
+  const call = createTalkHandlerCaller(talkSessionHandlers);
+  let sessionId: string;
+  let request: RealtimeVoiceBridgeCreateRequest;
+  let bridge: ReturnType<typeof makeRelayTransport> & {
+    sendUserMessage: Mock<NonNullable<RealtimeVoiceBridge["sendUserMessage"]>>;
+  };
+  let createBridge: Mock<(next: RealtimeVoiceBridgeCreateRequest) => RealtimeVoiceBridge>;
+
+  beforeEach(async () => {
+    bridge = makeRelayTransport({
+      sendUserMessage: vi.fn<NonNullable<RealtimeVoiceBridge["sendUserMessage"]>>(),
+    });
+    createBridge = vi.fn((next: RealtimeVoiceBridgeCreateRequest) => {
+      request = next;
+      return bridge;
+    });
+    const { relay } = await createRelay({ provider: createIdleRelayProvider(createBridge) });
+    sessionId = relay.id;
+    rememberUnifiedTalkSession(sessionId, {
+      kind: "realtime-relay",
+      connId: "conn-1",
+      relaySessionId: relay.id,
+      sessionTarget: relay.sessionTarget,
+    });
+    request.onReady?.();
+  });
+
+  async function send(params: Record<string, unknown>, connId = "conn-1") {
+    const respond = vi.fn();
+    await call("talk.session.sendText", { params, client: { connId }, respond });
+    return respond;
+  }
+
+  it("sends trimmed text exactly once through the same connected provider bridge", async () => {
+    const respond = await send({ sessionId, text: "  A red cup is on the table.\n" });
+    expect(respond).toHaveBeenCalledExactlyOnceWith(true, { ok: true }, undefined);
+    expect(bridge.sendUserMessage).toHaveBeenCalledExactlyOnceWith("A red cup is on the table.");
+    expect(createBridge).toHaveBeenCalledTimes(1);
+    expect(bridge.connect).toHaveBeenCalledTimes(1);
+    expect(bridge.close).not.toHaveBeenCalled();
+    expect(bridge.submitToolResult).not.toHaveBeenCalled();
+  });
+
+  it.each([4197, 8192])(
+    "accepts a %i-character photo speech envelope without truncation",
+    async (length) => {
+      const text = "a".repeat(length);
+      expect(await send({ sessionId, text })).toHaveBeenCalledWith(true, { ok: true }, undefined);
+      expect(bridge.sendUserMessage).toHaveBeenCalledExactlyOnceWith(text);
+    },
+  );
+
+  it.each([
+    { text: "" },
+    { text: " \n\t " },
+    { text: "a".repeat(8193) },
+    { text: 42 },
+    { text: "valid", extra: true },
+    {},
+  ])("rejects invalid text parameters %# before provider submission", async (params) => {
+    expect(await send({ sessionId, ...params })).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({ code: "INVALID_REQUEST" }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+  });
+
+  it.each(["conn-other", ""])("rejects a non-owning connection %s", async (connId) => {
+    expect(await send({ sessionId, text: "Do not speak." }, connId)).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({
+        code: "UNAVAILABLE",
+        message: expect.stringContaining("not owned"),
+      }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+  });
+
+  it("rejects a closed session without creating a replacement", async () => {
+    const respond = vi.fn();
+    await call("talk.session.close", { params: { sessionId }, respond });
+    expect(respond).toHaveBeenCalledWith(true, { ok: true }, undefined);
+    expect(await send({ sessionId, text: "Late answer." })).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({ code: "UNAVAILABLE" }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+    expect(createBridge).toHaveBeenCalledTimes(1);
+    expect(bridge.connect).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects a connected provider that has not become ready after continuity reset", async () => {
+    request.onEvent?.({ direction: "client", type: "session.continuity.reset" });
+    expect(await send({ sessionId, text: "Wait for readiness." })).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({
+        code: "UNAVAILABLE",
+        message: expect.stringContaining("not ready"),
+      }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+  });
+
+  it("rejects a disconnected provider even after its ready callback", async () => {
+    bridge.isConnected.mockReturnValue(false);
+    expect(await send({ sessionId, text: "Do not queue." })).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({
+        code: "UNAVAILABLE",
+        message: expect.stringContaining("not ready"),
+      }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+    expect(bridge.connect).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects a provider without text input support", async () => {
+    const unsupportedBridge = makeRelayTransport();
+    const { relay } = await createRelay({
+      connId: "no-text",
+      provider: createIdleRelayProvider((next) => {
+        request = next;
+        return unsupportedBridge;
+      }),
+    });
+    rememberUnifiedTalkSession(relay.id, {
+      kind: "realtime-relay",
+      connId: "no-text",
+      relaySessionId: relay.id,
+      sessionTarget: relay.sessionTarget,
+    });
+    request.onReady?.();
+    expect(
+      await send({ sessionId: relay.id, text: "No fallback." }, "no-text"),
+    ).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({
+        code: "UNAVAILABLE",
+        message: expect.stringContaining("does not support text"),
+      }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+    expect(unsupportedBridge.submitToolResult).not.toHaveBeenCalled();
+    expect(unsupportedBridge.connect).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects non-realtime sessions", async () => {
+    const id = "managed-room-test";
+    rememberUnifiedTalkSession(id, { kind: "managed-room", handoffId: id, roomId: id });
+    onTestFinished(() => forgetUnifiedTalkSession(id));
+    expect(await send({ sessionId: id, text: "No TTS fallback." })).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({ code: "INVALID_REQUEST" }),
+    );
+    expect(bridge.sendUserMessage).not.toHaveBeenCalled();
+  });
+
+  it("reports provider submission failure without retrying or claiming success", async () => {
+    bridge.sendUserMessage.mockImplementationOnce(() => {
+      throw new Error("Text transport failed");
+    });
+    expect(await send({ sessionId, text: "A red cup." })).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({
+        code: "UNAVAILABLE",
+        message: expect.stringContaining("Text transport failed"),
+      }),
+    );
+    expect(bridge.sendUserMessage).toHaveBeenCalledTimes(1);
+    expect(bridge.connect).toHaveBeenCalledTimes(1);
+    expect(bridge.submitToolResult).not.toHaveBeenCalled();
+  });
+});
