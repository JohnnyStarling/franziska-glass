+#!/usr/bin/env python3
+"""Keep one decorative upstream rock texture below Android's path string limit.
+
+The immutable resources checkout is not changed. Only the generated resource is
+rewritten: three decimal places on a 72-unit decorative viewport, never GPS or
+route geometry. Every numeric change is checked against a 0.0005-unit bound.
+"""
+from decimal import Decimal, ROUND_HALF_UP
+from pathlib import Path
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+NS = 'http://schemas.android.com/apk/res/android'
+TOKEN = re.compile(r'[AaCcHhLlMmQqSsTtVvZz]|[-+]?(?:\d*\.\d+|\d+\.?\d*)(?:[eE][-+]?\d+)?')
+ET.register_namespace('android', NS)
+
+
+def main():
+    path = Path(sys.argv[1])
+    tree = ET.parse(path)
+    changed = False
+    for element in tree.getroot().iter('path'):
+        key = '{' + NS + '}pathData'
+        data = element.get(key, '')
+        if len(data.encode()) < 32767:
+            continue
+        tokens = TOKEN.findall(data)
+        out = []
+        previous = None
+        for token in tokens:
+            if token.isalpha():
+                out.append(token)
+                previous = None
+                continue
+            original = Decimal(token)
+            rounded = original.quantize(Decimal('0.001'), rounding=ROUND_HALF_UP)
+            assert abs(original - rounded) <= Decimal('0.0005')
+            token = format(rounded, 'f').rstrip('0').rstrip('.') if rounded % 1 else str(int(rounded))
+            token = re.sub(r'^(-?)0\.', r'\1.', token)
+            if previous is not None and not token.startswith('-'):
+                out.append(',')
+            out.append(token)
+            previous = token
+        compact = ''.join(out)
+        assert len(compact.encode()) < 32767, 'Decorative vector still exceeds Android string pool limit'
+        assert [t for t in tokens if t.isalpha()] == [t for t in TOKEN.findall(compact) if t.isalpha()]
+        assert len(tokens) == len(TOKEN.findall(compact))
+        element.set(key, compact)
+        print(path.name + ': bounded decorative path ' + str(len(data)) + ' -> ' + str(len(compact)))
+        changed = True
+    if changed:
+        tree.write(path, encoding='utf-8', xml_declaration=True)
+
+
+if __name__ == '__main__':
+    main()
