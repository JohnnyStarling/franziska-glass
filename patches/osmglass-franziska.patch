+package com.goodanser.osmglass.glass.transport;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Owner-selected Bluetooth identity; no trust-on-first-connect or insecure fallback. */
+public final class TrustedPhoneStore {
+    public static final String KEY = "trusted_phone";
+    private TrustedPhoneStore() { }
+    public static SharedPreferences preferences(Context c) {
+        return c.getSharedPreferences("navigation_peer", Context.MODE_PRIVATE);
+    }
+    public static String selected(Context c) { return preferences(c).getString(KEY, ""); }
+    public static boolean admits(String selected, String remote, boolean bonded) {
+        return bonded && selected != null && !selected.isEmpty() && selected.equalsIgnoreCase(remote);
+    }
+}
