@@ -0,0 +1,41 @@
+package com.goodanser.osmglass.glass.livecard;
+
+/** Allocation-free format/dimension admission. Decoder still performs its own bounds validation. */
+public final class SnippetImagePolicy {
+    public static final int MAX_BYTES = 128 * 1024;
+    private SnippetImagePolicy() { }
+    public static boolean accepts(byte[] b) {
+        if (b == null || b.length < 24 || b.length > MAX_BYTES) return false;
+        if ((b[0]&255)==137 && b[1]==80 && b[2]==78 && b[3]==71 && b[4]==13 && b[5]==10
+                && b[6]==26 && b[7]==10 && be32(b,8)==13 && word(b,12,"IHDR")) {
+            return be32(b,16)==640 && be32(b,20)==360;
+        }
+        if (b.length < 30 || !word(b,0,"RIFF") || !word(b,8,"WEBP") || le32(b,4) != b.length-8) return false;
+        long size = le32(b,16);
+        if (size < 10 || size > b.length - 20) return false;
+        int width, height;
+        if (word(b,12,"VP8 ")) {
+            if (b[23]!=(byte)0x9d || b[24]!=1 || b[25]!=0x2a) return false;
+            width = ((b[26]&255) | (b[27]&255)<<8) & 0x3fff;
+            height = ((b[28]&255) | (b[29]&255)<<8) & 0x3fff;
+        } else if (word(b,12,"VP8X")) {
+            // Animation is not a supported navigation snippet.
+            if ((b[20]&2)!=0) return false;
+            width=1+le24(b,24); height=1+le24(b,27);
+        } else if (word(b,12,"VP8L")) {
+            if (b[20]!=0x2f) return false;
+            width=1+((b[21]&255)|((b[22]&0x3f)<<8));
+            height=1+(((b[22]&255)>>6)|((b[23]&255)<<2)|((b[24]&0x0f)<<10));
+        } else return false;
+        return width==640 && height==360;
+    }
+    private static boolean word(byte[] b,int o,String s) {
+        for (int i=0;i<4;i++) if ((b[o+i]&255)!=s.charAt(i)) return false;
+        return true;
+    }
+    private static long be32(byte[] b,int o) {
+        return ((long)(b[o]&255)<<24)|((long)(b[o+1]&255)<<16)|((long)(b[o+2]&255)<<8)|(b[o+3]&255);
+    }
+    private static long le32(byte[] b,int o) { return (b[o]&255)|((long)(b[o+1]&255)<<8)|((long)(b[o+2]&255)<<16)|((long)(b[o+3]&255)<<24); }
+    private static int le24(byte[] b,int o) { return (b[o]&255)|((b[o+1]&255)<<8)|((b[o+2]&255)<<16); }
+}
